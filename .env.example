# Copiar a .env únicamente mediante Codex. No pegar secretos en el chat.
APP_ENV=development
DATABASE_URL=sqlite:///./cybersos-dev.db
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_SETUP_PASSWORD=replace-with-a-fixed-private-activation-password
COOKIE_SECURE=false
LOCAL_ADMIN_EMAIL=admin@cybersos.example
# Cambia estos valores solo en .env usando scripts/configurar_admin_local.ps1.
LOCAL_ADMIN_PASSWORD=replace-for-local-demo
LOCAL_MFA_CODE=123456
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATA_CONTROLLER_NAME=
PRIVACY_NOTICE_URL=
RETENTION_DAYS=90
PUBLIC_REPORT_RATE_LIMIT=5
PUBLIC_REPORT_RATE_WINDOW_SECONDS=3600
CRON_SECRET=

# Opcional: notificaciones institucionales y antivirus privado.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ANTIVIRUS_ENABLED=false
CLAMAV_URL=
CLAMAV_TOKEN=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
FRONTEND_ORIGIN=http://localhost:4174
VITE_API_URL=http://localhost:8000/api
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_SESSION_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BACKEND_WEBHOOK_URL=http://localhost:8000/api/internal/whatsapp/events
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_ADMIN_LOCAL=true
WHATSAPP_MAX_MEDIA_MB=20
# IA del agente ciudadano: solo backend, nunca usar prefijo VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_LOCAL_MODE=true
AI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_PROVIDER=openai
