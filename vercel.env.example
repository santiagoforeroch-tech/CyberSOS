# Plantilla segura para importar variables en Vercel.
# Reemplaza cada texto entre < > antes de importarla.
# Nunca subas este archivo con valores reales a GitHub.

APP_ENV=production
AUTH_PROVIDER=supabase
COOKIE_SECURE=true

DATABASE_URL=<CADENA_POSTGRESQL_DE_SUPABASE>
SESSION_SECRET=<CLAVE_LARGA_Y_PRIVADA_NUEVA>
ADMIN_SETUP_PASSWORD=<CONTRASEÑA_FIJA_PRIVADA_DE_ACTIVACIÓN>
CRON_SECRET=<CLAVE_LARGA_Y_PRIVADA_PARA_LA_TAREA_DE_RETENCION>

# Se activan únicamente después de configurar los servicios externos.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=<CLAVE_PRIVADA_DE_RESEND>
NOTIFICATION_FROM=<REMITENTE_VERIFICADO>
ANTIVIRUS_ENABLED=false
CLAMAV_URL=<URL_PRIVADA_DEL_ESCANER_CLAMAV>
CLAMAV_TOKEN=<TOKEN_PRIVADO_DEL_ESCANER>

SUPABASE_URL=<URL_DE_TU_PROYECTO_SUPABASE>
SUPABASE_PUBLISHABLE_KEY=<CLAVE_PUBLICABLE_DE_SUPABASE>
SUPABASE_SECRET_KEY=<CLAVE_SECRETA_DE_SUPABASE>
SUPABASE_ADMIN_EMAIL=<TU_CORREO_ADMINISTRADOR_AUTORIZADO>
