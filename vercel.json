{
  "services": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "backend/main.py",
      "routePrefix": "/api",
      "framework": "fastapi"
    }
  },
  "crons": [
    {
      "path": "/api/internal/retention/run",
      "schedule": "17 3 * * *"
    }
  ]
}
